{
  "name": "@openofficellm/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local host service for OpenOfficeLLM — TLS, auth, secrets, provider brokering.",
  "bin": {
    "openofficellm-host": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "build:sea": "tsup && node ../../scripts/build-sea.mjs",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@openofficellm/shared": "^0.1.0",
    "hono": "^4.7.10",
    "node-forge": "^1.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.11",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
